# Docker / PostgreSQL
APP_PORT=8093
POSTGRES_DB=simplekitchen_admin
POSTGRES_USER=simplekitchen
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_HEX_VALUE

# Sessions
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS

# Only used if the restored database contains no portal users.
# Leave blank when restoring the existing production database.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# WooCommerce
WC_STORE_URL=https://simplekitchenprep.com
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
WC_WEBHOOK_SECRET=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# Stripe.
# The portal can also use Stripe keys stored in its Settings table.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SUBSCRIBER_WEBHOOK_SECRET=

# Customer app background notifications (P-256 VAPID private key, base64url encoded)
CUSTOMER_PUSH_VAPID_PRIVATE_KEY=
CUSTOMER_PUSH_VAPID_SUBJECT=mailto:hello@simplekitchenprep.com

# Driver dispatch development — isolated from existing routes
# Set DRIVER_PORTAL_URL to the HTTPS origin only (no /driver suffix).
DRIVER_PORTAL_URL=https://admin.simplekitchenprep.com
DISPATCH_TEST_MODE=enabled
# Leave disabled until delivery event and test-alias QA are complete.
DISPATCH_CUSTOMER_NOTIFICATIONS=disabled
DISPATCH_CUSTOMER_TRACKING=disabled
# Road ETA uses public OSRM / OpenStreetMap; live traffic is not available.
